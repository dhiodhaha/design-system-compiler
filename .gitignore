# Kept locally so `pnpm compile` / `pnpm verify` stay offline-reproducible.
.design-compiler/raw/
.design-compiler/reference/

# typescript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo

# Figma PRO raw payloads (licensed content, never published)
.design-compiler/references/figma/raw/
