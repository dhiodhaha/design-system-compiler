{
  "//": "Validation config for the adopted payload. Mirrors the upstream compiler options (strict, bundler resolution) with `@/*` mapped to the payload root, exactly as it maps to a consumer's source root.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "exclude": [
    "./**/*.demo.tsx",
    "./**/*.story.tsx",
    "./**/*.test.tsx"
  ]
}
