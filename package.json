{
  "name": "ds-compiler-p0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "compile": "node compiler/figma/normalize.mjs && node compiler/figma/compile.mjs",
    "test": "node --test tests/invariants.test.mjs",
    "verify": "pnpm compile && pnpm test && bun tests/ssr.tsx && node visual/check-css.mjs && node visual/verify-matrix.mjs --dpr 2 --canaries && node visual/verify-matrix.mjs --dpr 2 && node visual/verify-matrix.mjs --dpr 1 && node visual/run.mjs && node visual/behavior.mjs && node visual/accuracy.mjs",
    "reference:index": "node compiler/reference/index-oss.mjs --repo ${OSS_REPO:-/tmp/untitled-react}",
    "reference:diff": "node compiler/reference/index-oss.mjs --repo ${OSS_REPO:-/tmp/untitled-react} --diff",
    "reference:crosswalk": "node compiler/reference/crosswalk.mjs",
    "reference:gaps": "node compiler/reference/pro-gaps.mjs",
    "adopt": "node compiler/adopt/adopt.mjs",
    "adopt:parity": "node compiler/adopt/parity.mjs --item button",
    "adopt:validate": "node compiler/adopt/validate.mjs --item button",
    "registry:build": "node compiler/registry/build.mjs --item button",
    "verify:adopted": "pnpm adopt:parity && pnpm adopt:validate && pnpm registry:build",
    "adopt:all": "node compiler/adopt/adopt.mjs --all",
    "state:reconcile": "node compiler/state/reconcile.mjs",
    "verify:library": "pnpm state:reconcile && pnpm verify",
    "report": "node compiler/report.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.3",
    "@react-aria/utils": "3.34.1",
    "@react-stately/utils": "3.12.1",
    "@untitledui/file-icons": "0.0.9",
    "@untitledui/icons": "0.0.22",
    "embla-carousel-react": "8.6.0",
    "input-otp": "1.4.2",
    "motion": "12.42.2",
    "next-themes": "0.4.6",
    "qr-code-styling": "1.9.2",
    "react": "^19.3.0",
    "react-aria": "3.51.0",
    "react-aria-components": "1.20.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "7.82.0",
    "react-stately": "3.48.0",
    "recharts": "3.10.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "css-tree": "^3.2.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-react-aria-components": "^2.2.0",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.7.3",
    "vite": "^8.3.0"
  },
  "pnpm": {
    "overrides": {
      "@internationalized/date": "3.12.3"
    }
  }
}
